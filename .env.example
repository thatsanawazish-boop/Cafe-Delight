# Copy this file to .env.local, fill in the values, then restart the server.

# Staff and owner login: Clerk (/admin, /admin/orders, /admin/sales)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Order saving and the owner dashboard: Supabase (server-only, never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: any random text, used to hash visitor addresses for the review spam limit
IP_HASH_SECRET=
